---
/**
 * Formulario B2B. Envía por POST (FormData) al endpoint definido en PUBLIC_FORM_ENDPOINT
 * (Formspree, Netlify Forms, un webhook de HubSpot/Zapier, etc.).
 * Admite precarga por URL: ?ingredient=habanero&format=mash&topic=spec
 */
import { contact, contactOptions } from '../data/pages/contact';
import type { Lang } from '../i18n/config';
import { routes } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = contact[lang].form;
const { ingredientOptions, formatOptions, companyTypes } = contactOptions;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<form
  id="form"
  class="form"
  method="post"
  action={endpoint || undefined}
  data-endpoint={endpoint}
  data-sending={f.sending}
  data-error={f.error}
  data-dev={import.meta.env.DEV ? 'true' : undefined}
>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="topic" value="" />
  <!-- Honeypot anti-spam -->
  <div class="hp" aria-hidden="true">
    <label>Website <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <fieldset class="form__group">
    <legend class="form__legend">{f.legendContact}</legend>
    <div class="form__grid">
      <div class="field">
        <label for="f-name">{f.name}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-company">{f.company}</label>
        <input id="f-company" name="company" type="text" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="f-role">{f.role}</label>
        <input id="f-role" name="role" type="text" autocomplete="organization-title" />
      </div>
      <div class="field">
        <label for="f-email">{f.email}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-phone">{f.phone} <span class="opt">{f.optional}</span></label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="f-country">{f.country}</label>
        <input id="f-country" name="country" type="text" autocomplete="country-name" required />
      </div>
      <div class="field field--full">
        <label for="f-type">{f.companyType}</label>
        <select id="f-type" name="company_type" required>
          <option value="" disabled selected>{f.select}</option>
          {companyTypes.map((o) => <option value={o.value}>{o[lang]}</option>)}
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset class="form__group">
    <legend class="form__legend">{f.legendProject}</legend>

    <fieldset class="field field--full choice">
      <legend>{f.ingredient} <span class="opt">{f.multiHint}</span></legend>
      <div class="choice__list">
        {ingredientOptions.map((o) => (
          <label class="choice__item">
            <input type="checkbox" name="ingredient" value={o.value} />
            <span>{o[lang]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="field field--full choice">
      <legend>{f.format} <span class="opt">{f.multiHint}</span></legend>
      <div class="choice__list">
        {formatOptions.map((o) => (
          <label class="choice__item">
            <input type="checkbox" name="format" value={o.value} />
            <span>{o[lang]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="form__grid">
      <div class="field">
        <label for="f-volume">{f.volume}</label>
        <input id="f-volume" name="volume" type="text" placeholder={f.volumePh} />
      </div>
      <div class="field">
        <label for="f-packaging">{f.packaging}</label>
        <input id="f-packaging" name="packaging" type="text" placeholder={f.packagingPh} />
      </div>
      <div class="field">
        <label for="f-application">{f.application}</label>
        <input id="f-application" name="application" type="text" placeholder={f.applicationPh} />
      </div>
      <div class="field">
        <label for="f-market">{f.market}</label>
        <input id="f-market" name="destination_market" type="text" />
      </div>
      <div class="field field--full">
        <label for="f-message">{f.message}</label>
        <textarea id="f-message" name="message" rows="5"></textarea>
      </div>
    </div>
  </fieldset>

  <label class="consent">
    <input type="checkbox" name="data_consent" value="yes" required />
    <span>{f.consent} <a href={routes.privacy[lang]} target="_blank" rel="noopener">{f.consentLink}</a>.</span>
  </label>

  <div class="form__footer">
    <button class="btn btn--primary form__submit" type="submit">{f.submit}</button>
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>

  <div class="form__success" hidden tabindex="-1">
    <p>{f.success}</p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#form');
  if (form) {
    // Precarga desde la URL (?ingredient=…&format=…&topic=…)
    const params = new URLSearchParams(location.search);
    for (const key of ['ingredient', 'format']) {
      params.getAll(key).forEach((v) => {
        const box = form.querySelector<HTMLInputElement>(`input[name="${key}"][value="${CSS.escape(v)}"]`);
        if (box) box.checked = true;
      });
    }
    const topic = params.get('topic');
    if (topic) form.querySelector<HTMLInputElement>('input[name="topic"]')!.value = topic;

    const status = form.querySelector<HTMLElement>('.form__status')!;
    const submit = form.querySelector<HTMLButtonElement>('.form__submit')!;
    const success = form.querySelector<HTMLElement>('.form__success')!;
    const { endpoint, sending, error, dev } = form.dataset;

    const showSuccess = () => {
      form.querySelectorAll('fieldset, .consent, .form__footer').forEach((el) => ((el as HTMLElement).hidden = true));
      success.hidden = false;
      success.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      submit.disabled = true;
      status.textContent = sending ?? '';
      try {
        if (!endpoint) {
          if (dev) {
            console.info('[form] PUBLIC_FORM_ENDPOINT no configurado. Datos:', Object.fromEntries(new FormData(form)));
            return showSuccess();
          }
          throw new Error('No endpoint');
        }
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        showSuccess();
      } catch {
        status.textContent = error ?? '';
      } finally {
        submit.disabled = false;
        if (!success.hidden) status.textContent = '';
      }
    });
  }
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-lg);
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 2.5rem);
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: calc(var(--radius) * 1.25);
    box-shadow: var(--shadow);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  fieldset { border: 0; padding: 0; min-width: 0; }
  .form__group { display: grid; gap: var(--space-md); }
  .form__legend {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
    padding: 0;
    margin-bottom: var(--space-md);
  }
  .form__grid { display: grid; gap: var(--space-md) var(--space-md); }
  @media (min-width: 40rem) {
    .form__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--full { grid-column: 1 / -1; }
  }

  .field { display: grid; gap: 0.375rem; }
  .field > label,
  .choice > legend { font-size: var(--fs-sm); font-weight: 600; color: var(--c-text); padding: 0; }
  .choice > legend { margin-bottom: 0.625rem; }
  .opt { font-weight: 400; color: var(--c-text-muted); }

  input[type='text'], input[type='email'], input[type='tel'], select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.875rem;
    font-size: 1rem; /* evita zoom en iOS */
    background: var(--c-bg);
    border: 1px solid #c4cec0;
    border-radius: var(--radius-sm);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  textarea { resize: vertical; min-height: 8rem; }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: none;
    border-color: var(--c-brand);
    box-shadow: 0 0 0 3px var(--c-brand-soft);
  }
  input:user-invalid, select:user-invalid { border-color: var(--c-error); }
  ::placeholder { color: #8c968f; }

  .choice__list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .choice__item { position: relative; cursor: pointer; }
  .choice__item input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .choice__item span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid #c4cec0;
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .choice__item:hover span { border-color: var(--c-brand); }
  .choice__item input:checked + span { background: var(--c-brand); border-color: var(--c-brand); color: var(--c-on-brand); }
  .choice__item input:focus-visible + span { outline: 3px solid var(--c-brand); outline-offset: 2px; }

  .consent { display: flex; gap: 0.75rem; align-items: flex-start; font-size: var(--fs-sm); color: var(--c-text-muted); cursor: pointer; }
  .consent input { flex-shrink: 0; width: 1.25rem; height: 1.25rem; margin-top: 0.15em; accent-color: var(--c-brand); }

  .form__footer { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  .form__submit:disabled { opacity: 0.6; cursor: progress; }
  .form__status { font-size: var(--fs-sm); color: var(--c-text-muted); }
  @media (max-width: 29.99rem) { .form__submit { width: 100%; } }

  .form__success {
    padding: var(--space-md);
    border-radius: var(--radius);
    background: var(--c-brand-soft);
    color: var(--c-brand-hover);
    font-weight: 600;
    font-size: var(--fs-lg);
  }
  .form__success:focus { outline: none; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
