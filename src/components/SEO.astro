---
import { langs, ogLocales, xDefaultLang, type Lang } from '../i18n/config';
import type { Alternates } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  siteName: string;
  /** URL relativa de cada versión idiomática de esta página */
  alternates: Alternates;
  /** Imagen OG (1200×630) relativa a /public */
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, siteName, alternates, image = '/og-image.jpg', noindex = false, jsonLd = [] } = Astro.props;

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(alternates[lang]);
const ogImage = abs(image);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

{!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={abs(alternates[xDefaultLang])} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocales[lang]} />
{langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
