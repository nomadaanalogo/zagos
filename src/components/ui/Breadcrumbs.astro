---
import { common } from '../../data/common';
import type { Lang } from '../../i18n/config';
import { routes } from '../../i18n/routes';
import type { Crumb } from '../../layouts/BaseLayout.astro';

interface Props { lang: Lang; items: Crumb[]; tone?: 'default' | 'light' }
const { lang, items, tone = 'default' } = Astro.props;
const all = [{ label: common[lang].breadcrumbHome, href: routes.home[lang] }, ...items];
---

<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label={common[lang].breadcrumbLabel}>
  <ol>
    {all.map((c, i) => (
      <li>
        {i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { font-size: var(--fs-sm); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; list-style: none; padding: 0; }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--c-text-muted); }
  .crumbs li + li::before { content: '/'; opacity: 0.5; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs [aria-current] { color: var(--c-text); font-weight: 600; }

  .crumbs--light li { color: rgb(255 255 255 / 0.7); }
  .crumbs--light a:hover { color: #fff; }
  .crumbs--light [aria-current] { color: #fff; }
</style>
