---
/** Credenciales con sello propio de la marca (ver nota en data/common.ts). */
import Seal from './Seal.astro';
import { credentials } from '../../data/common';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
---

<ul class:list={['creds', { 'creds--compact': compact }]}>
  {credentials[lang].map((c, i) => (
    <li class="creds__item" data-reveal style={`--i:${i}`}>
      <Seal text={c.seal} logo={c.logo} size={compact ? "sm" : "md"} />
      <div>
        <p class="creds__name">{c.name}</p>
        {!compact && <p class="creds__note">{c.note}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .creds {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    grid-template-columns: minmax(0, 1fr);
  }
  .creds__item {
    display: grid;
    grid-template-columns: 8rem 1fr; /* columna fija para el logo: los textos quedan alineados */
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 2px solid var(--c-border);
  }
  .creds__item :global(.seal) { justify-self: start; }
  .creds__name { font-size: var(--fs-lg); font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }
  .creds__note { margin-top: 0.375rem; font-size: var(--fs-sm); line-height: 1.55; color: var(--c-text-muted); }

  @media (min-width: 40rem) {
    .creds { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .creds:not(.creds--compact) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
