---
/**
 * Sello de credencial: muestra el logo entregado por ZAGOS (si existe, en negro con transparencia);
 * si no, un sello propio con la sigla en el verde de marca.
 */
import { Image } from 'astro:assets';
import { getPhoto } from '../../data/photos';

interface Props { text: string; logo?: string; size?: 'sm' | 'md' | 'lg' }
const { text, logo, size = 'md' } = Astro.props;
const img = getPhoto(logo);
---

{img ? (
  <span class:list={['seal', 'seal--logo', `seal--${size}`]} aria-hidden="true">
    <Image src={img} alt="" width={180} densities={[1, 2]} loading="lazy" class="seal__img" />
  </span>
) : (
  <span class:list={['seal', `seal--${size}`, { 'seal--long': text.length > 4 }]} aria-hidden="true">
    <span class="seal__ring"></span>
    <span class="seal__text">{text}</span>
  </span>
)}

<style>
  .seal {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--c-brand);
    color: #fff;
  }
  .seal--sm { width: 3rem; height: 3rem; }
  .seal__ring {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1.5px dashed rgb(255 255 255 / 0.55);
  }
  .seal__text { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; line-height: 1; }
  .seal--long .seal__text { font-size: 0.5625rem; }
  .seal--sm .seal__text { font-size: 0.6875rem; }
  .seal--sm.seal--long .seal__text { font-size: 0.5rem; }

  /* Logo real: misma altura para todos, ancho según su proporción */
  .seal--logo {
    display: block;
    width: auto;
    height: 3.25rem;
    border-radius: 0;
    background: none;
  }
  .seal--sm.seal--logo { height: 2.5rem; }
  .seal--lg.seal--logo { height: 3.5rem; }
  .seal__img { display: block; width: auto; height: 100%; max-width: 8rem; object-fit: contain; }
</style>
