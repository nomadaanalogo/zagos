---
/**
 * Bloque editorial: línea superior + icono + título + texto. Sin caja, para evitar el
 * aspecto de "rejilla de tarjetas". Si tiene enlace, toda la pieza es clicable.
 */
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  /** Número visible (01, 02…) en lugar de icono */
  index?: number;
  eyebrow?: string;
  title: string;
  text?: string;
  items?: string[];
  link?: { label: string; href: string };
  id?: string;
  /** Retardo de la animación de entrada */
  delay?: number;
  /** Mantener por compatibilidad; el estilo es el mismo */
  variant?: 'default' | 'plain';
  as?: 'h3' | 'h4';
}

const { icon, index, eyebrow, title, text, items, link, id, delay = 0, as: H = 'h3' } = Astro.props;
---

<article id={id} class:list={['tile', { 'tile--link': link }]} data-reveal style={`--i:${delay}`}>
  <div class="tile__top">
    {index !== undefined ? (
      <span class="tile__num" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    ) : (
      icon && <span class="tile__icon"><Icon name={icon} size={26} /></span>
    )}
    {link && <span class="tile__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>}
  </div>
  {eyebrow && <p class="tile__eyebrow">{eyebrow}</p>}
  <H class="tile__title">
    {link ? <a href={link.href} class="tile__stretch">{title}</a> : title}
  </H>
  {text && <p class="tile__text">{text}</p>}
  {items && (
    <ul class="tile__list">
      {items.map((it) => <li>{it}</li>)}
    </ul>
  )}
  <slot />
  {link && <span class="tile__cta" aria-hidden="true">{link.label}</span>}
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding-top: var(--space-md);
    border-top: 2px solid var(--c-border);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .tile::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--c-accent);
    transition: width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile--link:hover::before { width: 100%; }

  .tile__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.375rem; }
  .tile__icon { color: var(--c-brand); }
  .tile__num {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-brand);
  }
  .tile__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--c-border);
    color: var(--c-brand);
    transition: background-color 0.25s, border-color 0.25s, color 0.25s, transform 0.25s;
  }
  .tile--link:hover .tile__arrow { background: var(--c-brand); border-color: var(--c-brand); color: #fff; transform: translateX(4px); }

  .tile__eyebrow {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  .tile__title { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.2; }
  .tile__stretch { color: inherit; text-decoration: none; }
  .tile__stretch::after { content: ''; position: absolute; inset: 0; }
  .tile--link:hover .tile__title { color: var(--c-brand); }
  .tile__text { color: var(--c-text-muted); line-height: 1.6; }
  .tile__list { list-style: none; padding: 0; display: grid; gap: 0.375rem; font-weight: 600; }
  .tile__list li { display: flex; gap: 0.5rem; }
  .tile__list li::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .tile__cta { margin-top: auto; padding-top: var(--space-xs); font-weight: 700; color: var(--c-brand); }

  /* Sobre fondos oscuros */
  :global(.section--dark) .tile { border-top-color: rgb(255 255 255 / 0.15); }
  :global(.section--dark) .tile__icon,
  :global(.section--dark) .tile__num { color: var(--zagos-green-light); }
  :global(.section--dark) .tile__text { color: var(--c-on-dark-muted); }
</style>
