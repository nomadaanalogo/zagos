---
/**
 * Foto optimizada (astro:assets): genera tamaños responsive en WebP, width/height
 * para evitar saltos de layout y lazy-loading. Sin `photo` muestra el placeholder.
 */
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { getPhoto } from '../../data/photos';

interface Props {
  photo?: string;
  alt: string;
  label?: string;
  /** Proporción del recorte, p. ej. "4/5". Se ignora con `fill`. */
  ratio?: string;
  /** Ocupa todo el contenedor padre (fondos). El padre debe tener position: relative. */
  fill?: boolean;
  /** Atributo sizes; por defecto media pantalla en escritorio */
  sizes?: string;
  /** Imagen principal de la página (LCP): carga inmediata y prioritaria */
  priority?: boolean;
  /** Punto focal del recorte (object-position) */
  focus?: string;
  class?: string;
}

const {
  photo,
  alt,
  label,
  ratio = '16/9',
  fill = false,
  sizes = '(max-width: 960px) 100vw, 50vw',
  priority = false,
  focus = '50% 50%',
  class: className,
} = Astro.props;

const img = getPhoto(photo);
const widths = img ? [480, 768, 1080, 1440, 1920, 2560].filter((w) => w <= img.width) : [];
---

{img ? (
  fill ? (
    <Image
      src={img}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['photo', 'photo--fill', className]}
      style={`object-position:${focus}`}
    />
  ) : (
    <div class:list={['photo-frame', className]} style={`aspect-ratio:${ratio}`}>
      <Image
        src={img}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="photo"
        style={`object-position:${focus}`}
      />
    </div>
  )
) : (
  <ImagePlaceholder alt={alt} label={label} ratio={ratio} fill={fill} class={className} />
)}

<style>
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .photo--fill { position: absolute; inset: 0; }
  .photo-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-placeholder);
  }
</style>
