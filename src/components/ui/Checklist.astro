---
/** Lista de verificación con separadores, legible y escaneable. */
import Icon from './Icon.astro';

interface Props {
  items: string[];
  cols?: 1 | 2;
  class?: string;
}
const { items, cols = 1, class: className } = Astro.props;
---

<ul class:list={['checklist', { 'checklist--2': cols === 2 }, className]}>
  {items.map((it, i) => (
    <li data-reveal style={`--i:${Math.min(i, 6)}`}>
      <span class="checklist__mark"><Icon name="check" size={15} /></span>
      <span>{it}</span>
    </li>
  ))}
</ul>

<style>
  .checklist { list-style: none; padding: 0; display: grid; border-top: 1px solid var(--c-border); }
  .checklist li {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-border);
    font-weight: 500;
    line-height: 1.5;
  }
  .checklist__mark {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05em;
    border-radius: 50%;
    background: var(--c-accent);
    color: #fff;
  }
  @media (min-width: 48rem) {
    .checklist--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-xl); }
  }

  :global(.section--dark) .checklist,
  :global(.split--dark) .checklist,
  :global(.section--dark) .checklist li,
  :global(.split--dark) .checklist li { border-color: rgb(255 255 255 / 0.14); }
</style>
