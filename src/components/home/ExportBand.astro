---
/** Export ready: bloque oscuro tipográfico con cinta de mercados en movimiento. */
import Icon from '../ui/Icon.astro';
import type { Lang } from '../../i18n/config';
import { href } from '../../i18n/routes';

interface Props { lang: Lang; eyebrow: string; title: string; text: string; markets: string[]; cta: string }
const { lang, eyebrow, title, text, markets, cta } = Astro.props;
---

<section class="xb" aria-labelledby="xb-title">
  <div class="container xb__grid">
    <div data-reveal>
      <p class="kicker xb__kicker">{eyebrow}</p>
      <h2 id="xb-title" class="display">{title}</h2>
    </div>
    <div class="xb__copy" data-reveal style="--i:1">
      <p>{text}</p>
      <a class="btn btn--light" href={href('export', lang)}>
        {cta} <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>

  <!-- Lista accesible + cinta visual duplicada (aria-hidden) para el bucle continuo -->
  <ul class="sr-only">{markets.map((m) => <li>{m}</li>)}</ul>
  <div class="xb__marquee" aria-hidden="true">
    <div class="xb__track">
      {[0, 1].map(() => (
        <ul class="xb__set">
          {markets.map((m) => (
            <li>
              <span>{m}</span>
              <Icon name="globe" size={28} class="xb__dot" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .xb {
    padding-block: var(--space-section);
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(100 167 0 / 0.18) 0%, transparent 60%),
      var(--c-dark);
    color: var(--c-on-dark);
    overflow: hidden;
  }
  .xb h2 { color: #fff; }
  .xb__kicker { color: var(--zagos-green-light); }
  .xb__grid { display: grid; gap: var(--space-lg); align-items: end; }
  .xb__copy { display: grid; gap: var(--space-lg); justify-items: start; }
  .xb__copy p { font-size: var(--fs-lg); line-height: 1.6; color: var(--c-on-dark-muted); max-width: 36rem; }
  @media (min-width: 60rem) {
    .xb__grid { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
  }

  .xb__marquee {
    margin-top: var(--space-xl);
    border-block: 1px solid rgb(255 255 255 / 0.12);
    padding-block: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .xb__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .xb__marquee:hover .xb__track { animation-play-state: paused; }
  .xb__set { display: flex; list-style: none; padding: 0; margin: 0; }
  .xb__set li {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-right: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-size: clamp(2rem, 1.25rem + 3.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .xb__set li:nth-child(even) span { color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.7); }
  .xb__set :global(.xb__dot) { color: var(--zagos-green); flex-shrink: 0; }

  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .xb__track { animation: none; width: auto; }
    .xb__set + .xb__set { display: none; }
    .xb__set { flex-wrap: wrap; padding-inline: var(--gutter); }
  }
</style>
