---
/** Cierre de página: bloque de marca con degradado (mismo estilo que Private Label del Home). */
import Icon from '../ui/Icon.astro';
import { highlight } from '../../utils/highlight';

interface Props {
  title: string;
  text?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  eyebrow?: string;
}
const { title, text, primary, secondary, eyebrow } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__box" data-reveal>
      <div class="cta__copy">
        {eyebrow && <p class="kicker cta__kicker">{eyebrow}</p>}
        <h2 id="cta-title" class="display" set:html={highlight(title)} />
        {text && <p class="cta__text">{text}</p>}
      </div>
      <div class="btn-row cta__actions">
        <a class="btn btn--light" href={primary.href}>
          {primary.label}
          <Icon name="arrow" size={18} />
        </a>
        {secondary && <a class="btn btn--outline-light" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-section); }
  .cta__box {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
    padding: clamp(2rem, 1.25rem + 4vw, 4.5rem);
    border-radius: calc(var(--radius) * 1.75);
    background:
      radial-gradient(120% 140% at 0% 100%, rgb(141 192 68 / 0.25) 0%, transparent 55%),
      linear-gradient(135deg, var(--zagos-green-dark) 0%, #1c7a2c 100%);
    color: var(--c-on-dark);
  }
  .cta h2 { color: #fff; max-width: 40rem; }
  .cta h2 :global(.hl) { color: var(--zagos-green-light); }
  .cta__kicker { color: #fff; }
  .cta__kicker::before { background: var(--zagos-green-light); }
  .cta__text { margin-top: var(--space-md); color: rgb(255 255 255 / 0.85); font-size: var(--fs-lg); line-height: 1.6; max-width: 38rem; }

  @media (min-width: 60rem) {
    .cta__box { grid-template-columns: 1fr auto; gap: var(--space-xl); }
    .cta__actions { justify-content: flex-end; }
  }
</style>
