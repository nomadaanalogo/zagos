---
/**
 * Sección de lista editorial (como "Modelos de negocio" del Home):
 * encabezado fijo a la izquierda + filas grandes con flecha a la derecha.
 * Las filas sin href se muestran sin flecha.
 */
import Icon from '../ui/Icon.astro';
import { highlight } from '../../utils/highlight';

export interface ListItem {
  id?: string;
  title: string;
  /** Subtítulo corto en cursiva (p. ej. nombre en el otro idioma) */
  sub?: string;
  text?: string;
  /** Etiquetas pequeñas (formatos, tipo de documento…) */
  tags?: string[];
  href?: string;
  /** Texto del enlace (se muestra bajo el texto) */
  cta?: string;
  icon?: string;
}

interface Props {
  id?: string;
  tone?: 'default' | 'alt';
  eyebrow?: string;
  title: string;
  lead?: string;
  note?: string;
  items: ListItem[];
  /** Mostrar 01, 02… en vez de icono */
  numbered?: boolean;
}

const { id, tone = 'default', eyebrow, title, lead, note, items, numbered = true } = Astro.props;
const headingId = `${id ?? 'list'}-title`;
---

<section id={id} class:list={['ls', `ls--${tone}`]} aria-labelledby={headingId}>
  <div class="container ls__grid">
    <header class="ls__head" data-reveal>
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      <h2 id={headingId} class="display" set:html={highlight(title)} />
      {lead && <p class="lead ls__lead">{lead}</p>}
      <slot name="head" />
    </header>

    <div>
      <ol class="ls__list">
        {items.map((it, i) => {
          const Tag = it.href ? 'a' : 'div';
          return (
            <li id={it.id} data-reveal style={`--i:${Math.min(i, 5)}`}>
              <Tag class:list={['ls__row', { 'is-link': it.href }]} href={it.href}>
                <span class="ls__marker" aria-hidden="true">
                  {numbered || !it.icon ? String(i + 1).padStart(2, '0') : <Icon name={it.icon} size={22} />}
                </span>
                <span class="ls__body">
                  <span class="ls__title">{it.title}</span>
                  {it.sub && <span class="ls__sub">{it.sub}</span>}
                  {it.text && <span class="ls__text">{it.text}</span>}
                  {it.tags && it.tags.length > 0 && (
                    <span class="ls__tags">{it.tags.map((t) => <span class="ls__tag">{t}</span>)}</span>
                  )}
                  {it.cta && <span class="ls__cta">{it.cta}</span>}
                </span>
                {it.href && <span class="ls__arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>}
              </Tag>
            </li>
          );
        })}
      </ol>
      {note && <p class="ls__note">{note}</p>}
    </div>
  </div>
</section>

<style>
  .ls { padding-block: var(--space-section); scroll-margin-top: var(--header-h); }
  .ls--alt { background: var(--c-surface); }
  .ls__grid { display: grid; gap: var(--space-xl); }
  .ls__lead { margin-top: var(--space-md); }
  .ls__head :global(.hl) { color: var(--c-brand); }
  @media (min-width: 60rem) {
    .ls__grid { grid-template-columns: 5fr 7fr; gap: clamp(3rem, 6vw, 6rem); align-items: start; }
    .ls__head { position: sticky; top: calc(var(--header-h) + 2rem); }
  }

  .ls__list { list-style: none; padding: 0; border-top: 1px solid var(--c-border); }
  .ls__list > li { border-bottom: 1px solid var(--c-border); scroll-margin-top: calc(var(--header-h) + 1rem); }
  .ls__row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem) clamp(0.25rem, 1vw, 1rem);
    color: var(--c-text);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .ls__row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 3px;
    background: var(--c-accent);
    transition: width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ls__marker {
    align-self: start;
    padding-top: 0.35em;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-brand);
    font-variant-numeric: tabular-nums;
  }
  .ls__body { display: grid; gap: 0.375rem; justify-items: start; }
  .ls__title {
    font-size: clamp(1.375rem, 1.15rem + 1vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .ls__sub { margin-top: -0.125rem; font-size: var(--fs-sm); color: var(--c-text-muted); font-style: italic; }
  .ls__text { color: var(--c-text-muted); max-width: 36rem; line-height: 1.6; }
  .ls__tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.25rem; }
  .ls__tag {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--c-brand-soft);
    color: var(--c-brand-hover);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .ls__cta { margin-top: 0.25rem; font-weight: 700; color: var(--c-brand); }
  .ls__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1.5px solid var(--c-border);
    color: var(--c-brand);
    transition: background-color 0.25s, border-color 0.25s, color 0.25s, transform 0.25s;
  }
  .ls__row.is-link:hover { background: var(--c-surface); }
  .ls--alt .ls__row.is-link:hover { background: var(--c-bg); }
  .ls__row.is-link:hover::before { width: 100%; }
  .ls__row.is-link:hover .ls__title { color: var(--c-brand); }
  .ls__row.is-link:hover .ls__arrow { background: var(--c-brand); border-color: var(--c-brand); color: #fff; transform: translateX(4px); }
  .ls__note { margin-top: var(--space-md); font-size: var(--fs-sm); color: var(--c-text-muted); }
</style>
